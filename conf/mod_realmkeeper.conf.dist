[worldserver]

########################################
# mod-realmkeeper configuration
########################################
#
#    RealmKeeper.Party.Enable
#        Description: Console commands that form a Playerbots party for a
#                     player in the world (.rk party add|remove|list), used
#                     by the RealmKeeper launcher.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

RealmKeeper.Party.Enable = 1

#
#    RealmKeeper.Party.GearQuality
#        Description: Best item quality of a party bot's equipment, random
#                     items for its level and spec.
#        Default:     3 - (Rare, blue)
#                     2 - (Uncommon, green)
#                     4 - (Epic, purple)

RealmKeeper.Party.GearQuality = 3

#
#    RealmKeeper.Party.GearLoweringChance
#        Description: Chance (0 to 1) for each equipment slot of a party bot
#                     to get one quality lower: with GearQuality 3, a mix of
#                     blue and green items.
#        Default:     0.35

RealmKeeper.Party.GearLoweringChance = 0.35

#
#    RealmKeeper.Channels.ServerNames
#        Description: A client in another language than the server's game
#                     data (French client, English data) joins General,
#                     Trade and LocalDefense under its own names: the
#                     channels the bots and the server use are the ones of
#                     the server's names. When enabled, such a join is
#                     answered with the server's channel, as the server does
#                     itself after a zone change.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

RealmKeeper.Channels.ServerNames = 1
